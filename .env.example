# AI feedback for the Practice area. Copy this file to .env.local and fill in at least one key.

# Google Gemini (recommended) — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model name. Defaults to gemini-3.6-flash (free tier, reads images).
GEMINI_MODEL=

# Groq (optional backup, also has a free tier) — key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model name. Defaults to qwen/qwen3.8-27b (the free Groq model that reads images).
GROQ_MODEL=

# Optional: the order models are tried in when one is out of free quota or busy (best first).
# Leave empty for the built-in chain (see README → Practice area).
# AI_MODEL_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:qwen/qwen3.8-27b
